

# --- 1. Экспозиция эндпоинтов Actuator (что отдаёт сервис) -------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics
MANAGEMENT_ENDPOINT_PROMETHEUS_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
# Общий тег, который добавится ко всем метрикам (для фильтрации в Grafana)
MANAGEMENT_METRICS_TAGS_APPLICATION=urfu-cake-shop-user-profile-service

# --- 2. Адрес этого сервиса для scrape (идёт в конфиг Prometheus) -------------
# Внутри docker-сети cake-shop-network:
PROMETHEUS_SCRAPE_TARGET=user-profile-service:8080
PROMETHEUS_METRICS_PATH=/actuator/prometheus
PROMETHEUS_SCRAPE_INTERVAL=15s

# --- 3. Prometheus (куда ходят за метриками) ---------------------------------
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_PUBLIC_URL=http://localhost:9090

# --- 4. Grafana (визуализация; сама ходит в Prometheus как datasource) -------
GRAFANA_URL=http://grafana:3000
GRAFANA_PUBLIC_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production
# Datasource Grafana -> Prometheus
GRAFANA_PROMETHEUS_DATASOURCE_URL=http://prometheus:9090

# --- 5. (Опционально) Pushgateway — если сервис пушит метрики сам ------------
# MANAGEMENT_PROMETHEUS_METRICS_EXPORT_PUSHGATEWAY_ENABLED=false
# MANAGEMENT_PROMETHEUS_METRICS_EXPORT_PUSHGATEWAY_BASE_URL=http://pushgateway:9091

# --- 6. (Опционально) OTLP — трейсы/метрики в OTEL Collector / Tempo / Jaeger
# MANAGEMENT_OTLP_METRICS_EXPORT_URL=http://otel-collector:4318/v1/metrics
# MANAGEMENT_OTLP_TRACING_EXPORT_URL=http://otel-collector:4318/v1/traces
